# Sentinel credentials, keys and endpoints.
# Copy to .env and fill in. .env is gitignored and must never be committed (CLAUDE.md rule 1).
# backend/core/config.py loads this file (python-dotenv, override=False: a real environment variable wins).

# --- Sandbox portal account — the raw values, NOT url-encoded. The code percent-encodes.
SENTINEL_EMAIL=you@example.com
SENTINEL_PASSWORD=

# --- Login and public exposure (decisions F41, F42). Accounts are created with
#     python -m backend.tools.users add <username> --role viewer|evaluator|admin
#     The tool prompts for the password. NO PASSWORD EVER GOES IN THIS FILE.
SENTINEL_SESSION_TTL_H=8          # session lifetime; the cookie is HttpOnly + SameSite=Strict
SENTINEL_PUBLIC_HOST=             # the tunnel hostname, e.g. sentinel-demo.tailXXXX.ts.net
                                  # set => TrustedHost accepts it, the session cookie goes Secure, HSTS on

# --- API keys for this platform (decision F23 — kept for scripts and tools). Generate each with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# The API refuses to start if either is unset. Never printed, never logged.
SENTINEL_API_KEY_ADMIN=
SENTINEL_API_KEY_VIEWER=

# --- Endpoints (from the official Consuming the Sentinel Camera Grid guide; docs/reference/sandbox-access-spec.md)
SENTINEL_CDN=https://cctv.corp8.cloud
SENTINEL_CATALOGUE_URL=           # catalogue override (S3.7, decision F45). Empty = the CDN's /cameras.json.
                                  # An absolute URL (a new grid's GET /api/ingest — the probe fetches it) or a
                                  # local JSON file path (the seeder reads it directly); both shapes accepted.
SENTINEL_STREAM_IP=103.250.160.189
SENTINEL_RTSP_PORT=8554
SENTINEL_WHEP_PORT=8889

# --- Runtime budget (docs/constraints.md)
SENTINEL_DB=data/sentinel.db
SENTINEL_ACTIVE_CAMERAS=6         # cap on concurrent stream pulls (5 seeded active sandbox cameras + the local second system); suspected RTSP session cap ~6
SENTINEL_INFER_FPS=3              # frames per second sampled per active camera
SENTINEL_API_PORT=8000
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_DIR=data/logs        # every process writes a rotating log file here

# --- Tools (decision F25). ffmpeg/ffprobe are NOT on the laptop's PATH; the code resolves this dir first, then PATH.
SENTINEL_FFMPEG_DIR=D:\projects\Sentinel_Repo\tools\ffmpeg\ffmpeg-master-latest-win64-gpl\bin

# --- Ingestion
SENTINEL_STALL_TIMEOUT_S=20       # no frame for this long -> kill the ffmpeg child, back off, restart
SENTINEL_CAPTION_BAND=0.05        # ignore detections whose box starts in the top 5% of the frame (burned-in caption)

# --- ANPR (task S2.3). Per-camera overrides live in the registry row's notes JSON
# ({"motion_min_ratio": ..., } — S2.3); these are the defaults.
SENTINEL_MOTION_MIN_RATIO=0.002   # foreground-pixel ratio below this -> frame skipped by the motion gate
SENTINEL_DETECT_CONF=0.4          # detector confidence floor (obj_conf x cls_conf)

# --- Time base (decisions F13, F29). The sandbox recordings loop (~12 h, starting ~21:00 on the burned-in clock).
# The epoch is a demo constant anchoring that clock for display and harvest alignment; never presented as a measurement.
SENTINEL_RECORDING_EPOCH=2026-06-13T21:00:00+05:30
SENTINEL_LOOP_SECONDS=43200
SENTINEL_PLAYBACK_OFFSET_S=0      # shifts the shared HLS "live" window; ~34000 puts the live edge in daylight

# --- Alerting (decision F21)
SENTINEL_ALERT_ON_FUZZY=false     # exact and ambiguity matches alert; fuzzy (weighted distance <= 1.0) only when true

# --- Health checker (decision F31). Background task in the API; 0 = off. Never probes the CDN.
SENTINEL_HEALTH_INTERVAL_S=300
SENTINEL_HLS_DIR=data/hls         # the workers' local HLS tees (one folder per camera); the relay
                                  # serves a tee when fresh (< 20 s) and health judges active cameras by it
SENTINEL_MEDIAMTX_HLS_PORT=8888  # mediamtx's own HLS muxer, bound to 127.0.0.1 only; the relay proxies local feeds from it
SENTINEL_FOOTAGE_DIR=D:\projects\sentinel-footage  # stock clips OUTSIDE the repo: raw/ in, feeds/ out (scripts/prepare_feeds.py)
