# Sentinel credentials and endpoints.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Portal account — the raw values, NOT url-encoded. The code percent-encodes.
SENTINEL_EMAIL=you@example.com
SENTINEL_PASSWORD=

# Endpoints (from the official Consuming the Sentinel Camera Grid guide)
SENTINEL_CDN=https://cctv.corp8.cloud
SENTINEL_STREAM_IP=103.250.160.189
SENTINEL_RTSP_PORT=8554
SENTINEL_WHEP_PORT=8889

# Runtime budget — see 02-hard-constraints.md
SENTINEL_DB=data/sentinel.db
SENTINEL_ACTIVE_CAMERAS=5         # cameras under continuous inference (matches active tier in data/camera_seed.csv)
SENTINEL_INFER_FPS=3              # frames per second sampled per active camera
SENTINEL_API_PORT=8000
SENTINEL_LOG_LEVEL=INFO

# Playback — the sandbox recordings loop (~12 h). Shift the shared "live"
# window into the daylight portion for the demo (see src/ingest/timeline.py).
SENTINEL_PLAYBACK_OFFSET_S=0
# Background camera health-check cadence (seconds)
SENTINEL_HEALTH_INTERVAL_S=300
