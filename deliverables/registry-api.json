    "/api/cameras/gap-analysis": {
      "get": {
        "tags": [
          "cameras"
        ],
        "summary": "Gap Analysis Endpoint",
        "description": "Model 1 deliverable: offline/ageing cameras + coverage gaps.\n\nFor each camera: nearest-neighbour distance (Haversine); cameras with\nno neighbour within *radius_km* are flagged as isolated coverage.",
        "operationId": "gap_analysis_endpoint_api_cameras_gap_analysis_get",
        "parameters": [
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 25.0,
              "title": "Radius Km"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
